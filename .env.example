# Opcional para rodar com Docker Compose: o compose já traz valores de desenvolvimento.
# Copie para .env (cp .env.example .env) para trocar qualquer um deles.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oficina

# Obrigatória (a aplicação não sobe sem ela). Em produção use um valor forte: openssl rand -hex 32
JWT_SECRET_KEY=segredo-jwt-somente-para-desenvolvimento

JWT_ALGORITHM=HS256

JWT_EXPIRE_MINUTES=60

# Chave dos sistemas externos que usam /integracoes (cabeçalho X-API-Key)
INTEGRACAO_API_KEY=chave-integracao-somente-para-desenvolvimento

# Opcional: imprime todo o SQL executado (apenas para depuração)
SQL_ECHO=false

# Cria um cliente e um veículo de exemplo (usuário com senha conhecida) ao subir;
# use apenas em desenvolvimento
SEED_DADOS_EXEMPLO=false